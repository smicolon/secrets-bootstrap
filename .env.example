# .env.example — infisical-bootstrap configuration template.
# Copy to .env (or source config.sh) and fill in real values.
# Never commit a file with real values.

# ── Infisical ────────────────────────────────────────────────────────────────

# URL of your self-hosted (or cloud) Infisical instance.
INFISICAL_API_URL=https://secrets.example.com

# Project display name and URL-safe slug.
PROJECT_NAME="My Project"
PROJECT_SLUG=my-project

# Whitespace-separated list of environments to provision.
# Default environments created by shouldCreateDefaultEnvs:true: dev staging prod.
ENVIRONMENTS="dev prod"

# Optional: whitespace-separated app names for monorepo folder layout.
# When set, creates a /<app> folder per app in each environment.
# Leave empty for single-app layout (all secrets at /).
MONOREPO_APPS=""
# MONOREPO_APPS="api worker frontend"

# Optional: provide to skip project creation on re-runs.
# INFISICAL_PROJECT_ID=<uuid>

# Optional: org ID (auto-detected from workspace list if blank).
# ORG_ID=<uuid>

# Output directory for generated machine-identity credential files (gitignored).
OUT_DIR=secrets

# ── 1Password Connect Server ─────────────────────────────────────────────────
# Infisical's 1Password integration requires a Connect SERVER, not a bare
# Service Account token. See README.md "1Password Connect Server" section.

# Base URL of your deployed 1Password Connect Server.
OP_INSTANCE_URL=https://op-connect.example.com

# API token issued by the Connect server (via `op connect server create`).
OP_SERVICE_TOKEN=<connect-server-api-token>

# Optional: provide to skip connection creation on re-runs.
# OP_CONNECTION_ID=<uuid>

# Name for the 1Password vault that Infisical will mirror secrets into.
# Default: PROJECT_SLUG value.
VAULT_NAME=my-project

# Name for the Infisical App Connection. Default: <PROJECT_SLUG>-1p.
CONNECTION_NAME=my-project-1p

# ── migrate-env-to-infisical.sh ───────────────────────────────────────────────

# Source .env file to migrate. Default: .env
SRC_ENV=.env

# Target Infisical environment slug.
TARGET_ENV=prod

# Secret path in Infisical. Default: / (root).
# Set to /<app> for monorepo (e.g. /api).
SECRET_PATH=/

# Set to 1 for a dry run (prints key names and lengths, no writes).
DRY_RUN=0

# Space-separated list of keys to skip during migration.
# SKIP_KEYS="GOOGLE_APPLICATION_CREDENTIALS PATH HOME"
