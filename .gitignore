# Secret output files produced by the bootstrap scripts.
# These contain real machine-identity credentials — never commit them.
secrets/
*.machine.env

# Local environment files (keep .env.example committed).
.env
.env.*
!.env.example

# Project config (contains real values filled in by the operator).
config.sh

# OS / editor
.DS_Store
.idea/
*.swp

# Agent scratch / working notes (never committed).
agent-artifacts/

# Dogfood artifact: this repo provisions itself, so its .infisical.json points
# at a real internal workspace — keep it out of the public repo. Consumer
# projects SHOULD commit their own .infisical.json (it contains no secrets).
.infisical.json
